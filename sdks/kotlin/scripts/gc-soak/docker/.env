# Port/layout from golem-agent-example infra/docker/.env
# Images: local WasmGC builds (not golemservices/*:v1.5.1). Tag set by build-images.sh.
GOLEM_LOCAL_IMAGE_TAG=wasmgc
POSTGRES_IMAGE_VERSION=17
REDIS_IMAGE_VERSION=8
NGINX_IMAGE_VERSION=1.29

GOLEM_ROUTER_PORT=9881
GOLEM_ROUTER_COMPONENT_MAX_SIZE_ALLOWED=1g

REGISTRY_SERVICE_HTTP_PORT=8083
REGISTRY_SERVICE_GRPC_PORT=9008
COMPONENT_COMPILATION_SERVICE_HTTP_PORT=8084
COMPONENT_COMPILATION_SERVICE_GRPC_PORT=9010
SHARD_MANAGER_HTTP_PORT=8081
SHARD_MANAGER_GRPC_PORT=9002
WORKER_EXECUTOR_HTTP_PORT=8082
WORKER_EXECUTOR_GRPC_PORT=9000
WORKER_SERVICE_HTTP_PORT=9005
WORKER_SERVICE_CUSTOM_REQUEST_PORT=9006
WORKER_SERVICE_GRPC_PORT=9007
DEBUGGING_SERVICE_HTTP_PORT=8086

# Host ports when exposing redis/postgres for hybrid host-binary mode
REDIS_HOST_PORT=6380
POSTGRES_HOST_PORT=5432

# golem_client::LOCAL_WELL_KNOWN_TOKEN — golem-cli builtin local auth
ADMIN_TOKEN=5c832d93-ff85-4a8f-9803-513950fdfdb1
MARKETING_TOKEN=5c832d93-ff85-4a8f-9803-513950fdfdb1
CORS_ORIGIN_REGEX=.*
